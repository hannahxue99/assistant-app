{
  "name": "assistant-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.17",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-speech-recognition": "^56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --tunnel --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:ios:dev": "APP_VARIANT=development expo prebuild --platform ios --clean",
    "prebuild:ios:release": "APP_VARIANT=production expo prebuild --platform ios --clean",
    "ios:dev": "APP_VARIANT=development expo prebuild --platform ios --clean && node scripts/ios-device-build.cjs development",
    "ios:release": "APP_VARIANT=production expo prebuild --platform ios --clean && node scripts/ios-device-build.cjs production",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test",
    "test": "npm run test:time && npm run test:schedule && npm run test:notifications && npm run test:understanding && npm run test:topics && npm run test:entry-time && npm run test:backup && npm run test:import && npm run test:database-runtime && npm run test:notification-isolation && npm run test:entry-consistency && npm run test:edit-date && npm run test:calendar && npm run test:assistant-db && npm run test:assistant-context && npm run test:assistant-protocol && npm run test:assistant-turn && npm run test:assistant-ui && npm run test:assistant-retrieval && npm run test:assistant-quality && npm run test:app-variants && npm run test:ios-device-build",
    "test:time": "tsx scripts/test-time.ts",
    "test:schedule": "tsx scripts/test-schedule.ts",
    "test:notifications": "tsx scripts/test-notification-copy.ts",
    "test:understanding": "tsx scripts/test-understanding-feedback.ts",
    "test:topics": "tsx scripts/test-topic-order.ts",
    "test:entry-time": "tsx scripts/test-entry-time.ts",
    "test:backup": "tsx scripts/test-backup-format.ts",
    "test:import": "tsx scripts/test-import-merge.ts",
    "test:database-runtime": "tsx scripts/test-database-runtime.ts",
    "test:notification-isolation": "node scripts/test-notification-isolation.cjs",
    "test:entry-consistency": "TZ=Asia/Shanghai node scripts/test-entry-consistency.cjs",
    "test:edit-date": "TZ=Asia/Shanghai tsx scripts/test-edit-date-decision.ts",
    "test:calendar": "TZ=Asia/Shanghai node scripts/test-calendar-sync.cjs",
    "test:assistant-db": "TZ=Asia/Shanghai node scripts/test-assistant-database.cjs",
    "test:assistant-context": "TZ=Asia/Shanghai tsx scripts/test-assistant-context.ts",
    "test:assistant-protocol": "TZ=Asia/Shanghai tsx scripts/test-assistant-protocol.ts",
    "test:assistant-turn": "TZ=Asia/Shanghai node scripts/test-assistant-turn.cjs",
    "test:assistant-ui": "TZ=Asia/Shanghai tsx scripts/test-assistant-ui.ts",
    "test:assistant-retrieval": "TZ=Asia/Shanghai tsx scripts/test-assistant-retrieval.ts",
    "test:assistant-quality": "TZ=Asia/Shanghai tsx scripts/test-assistant-quality.ts",
    "test:app-variants": "tsx scripts/test-app-variants.ts",
    "test:ios-device-build": "node scripts/test-ios-device-build.cjs"
  },
  "private": true
}
